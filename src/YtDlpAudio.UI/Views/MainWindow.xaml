<Window x:Class="YtDlpAudio.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:YtDlpAudio.UI.ViewModels"
        xmlns:models="clr-namespace:YtDlpAudio.Core.Models;assembly=YtDlpAudio.Core"
        xmlns:services="clr-namespace:YtDlpAudio.Core.Services;assembly=YtDlpAudio.Core"
        mc:Ignorable="d"
        Title="YtDlpAudio - High Quality MP3 Downloader"
        Height="760" Width="1020"
        MinHeight="600" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#18181B" Foreground="#F4F4F5">

    <Window.Resources>
        <!-- Style overrides for clean modern dark appearance -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#27272A" />
            <Setter Property="Foreground" Value="#FAFAFA" />
            <Setter Property="BorderBrush" Value="#3F3F46" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#3B82F6" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Top Header Bar -->
            <RowDefinition Height="Auto" /> <!-- Search & URL Input Card -->
            <RowDefinition Height="Auto" /> <!-- Audio Options Card -->
            <RowDefinition Height="*" />    <!-- Content Tabs (Search / Queue) -->
            <RowDefinition Height="Auto" /> <!-- Bottom Action Bar & Status -->
        </Grid.RowDefinitions>

        <!-- TOP HEADER BAR -->
        <Border Grid.Row="0" Padding="0,0,0,14" BorderBrush="#27272A" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎵 YtDlpAudio" FontSize="20" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,12,0"/>
                    <TextBlock Text="Audio &amp; MP3 Studio" FontSize="13" Foreground="#A1A1AA" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Auth State Badge -->
                    <Border Background="#27272A" CornerRadius="12" Padding="10,4" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#10B981" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AuthStatus.IsLoggedIn}" Value="False">
                                                <Setter Property="Fill" Value="#6B7280" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding AuthStatus.DisplayMode}" FontSize="12" Foreground="#D1D5DB" />
                        </StackPanel>
                    </Border>

                    <!-- Sign In / Out Button -->
                    <Button Content="Sign In" Command="{Binding SignInCommand}" Margin="0,0,8,0" Background="#374151">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AuthStatus.IsLoggedIn}" Value="True">
                                        <Setter Property="Content" Value="Sign Out" />
                                        <Setter Property="Command" Value="{Binding SignOutCommand}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Setup Dependencies" Command="{Binding SetupDependenciesCommand}" Background="#2563EB" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- SEARCH & URL INPUT CARD -->
        <Border Grid.Row="1" Background="#27272A" CornerRadius="8" Padding="14" Margin="0,14,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" 
                         ToolTip="Paste YouTube/YT Music URL or type a song, artist, or playlist title"/>

                <ComboBox Grid.Column="1" Margin="8,0" SelectedValue="{Binding SearchFilter}" Width="110"
                          VerticalContentAlignment="Center" Background="#18181B" Foreground="#FAFAFA">
                    <ComboBoxItem Content="Tracks" Tag="{x:Static services:SearchFilterType.Tracks}" IsSelected="True" />
                    <ComboBoxItem Content="Playlists" Tag="{x:Static services:SearchFilterType.Playlists}" />
                </ComboBox>

                <Button Grid.Column="2" Content="🔍 Search / Inspect" Command="{Binding SubmitInputCommand}" MinWidth="130" />
            </Grid>
        </Border>

        <!-- AUDIO OPTIONS CARD -->
        <Border Grid.Row="2" Background="#202023" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Quality:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#A1A1AA" />
                <ComboBox Width="130" SelectedValue="{Binding QualityPreset}" Margin="0,0,18,0">
                    <ComboBoxItem Content="320k CBR (Max)" IsSelected="True" Tag="{x:Static models:AudioQualityPreset.Cbr320k}" />
                    <ComboBoxItem Content="VBR V0 (Optimal)" Tag="{x:Static models:AudioQualityPreset.VbrV0}" />
                    <ComboBoxItem Content="192k Standard" Tag="{x:Static models:AudioQualityPreset.Cbr192k}" />
                </ComboBox>

                <CheckBox Content="Embed Cover Art (JPG)" IsChecked="{Binding EmbedAlbumArt}" Margin="0,0,14,0" Foreground="#E4E4E7" VerticalAlignment="Center" />
                <CheckBox Content="Embed ID3 Tags" IsChecked="{Binding EmbedMetadata}" Margin="0,0,14,0" Foreground="#E4E4E7" VerticalAlignment="Center" />
                <CheckBox Content="Clean YouTube Noise" IsChecked="{Binding CleanTitle}" Margin="0,0,14,0" Foreground="#E4E4E7" VerticalAlignment="Center" />

                <TextBlock Text="Save To:" VerticalAlignment="Center" Margin="10,0,6,0" Foreground="#A1A1AA" />
                <TextBox Text="{Binding OutputDirectory}" Width="250" FontSize="12" VerticalAlignment="Center" />
            </WrapPanel>
        </Border>

        <!-- CONTENT TABS: SEARCH RESULTS & DOWNLOAD QUEUE -->
        <TabControl Grid.Row="3" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0">
            <!-- TAB 1: SEARCH RESULTS -->
            <TabItem Header="Search Results" Foreground="#FAFAFA">
                <DataGrid ItemsSource="{Binding SearchResults}" AutoGenerateColumns="False" 
                          Background="#1E1E22" RowBackground="#232327" AlternatingRowBackground="#1A1A1D"
                          Foreground="#FAFAFA" GridLinesVisibility="None" HeadersVisibility="Column"
                          CanUserAddRows="False" IsReadOnly="True" Margin="0,8,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Type" Binding="{Binding TypeLabel}" Width="80" />
                        <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" />
                        <DataGridTextColumn Header="Artist / Channel" Binding="{Binding Author}" Width="200" />
                        <DataGridTextColumn Header="Duration / Tracks" Binding="{Binding DurationOrCountFormatted}" Width="120" />
                        <DataGridTemplateColumn Header="Action" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="+ Queue" Padding="6,2" FontSize="12"
                                            Command="{Binding DataContext.AddSearchResultToQueueCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" Background="#10B981" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- TAB 2: DOWNLOAD QUEUE -->
            <TabItem Header="Download Queue" Foreground="#FAFAFA">
                <DataGrid ItemsSource="{Binding QueueTracks}" AutoGenerateColumns="False"
                          Background="#1E1E22" RowBackground="#232327" AlternatingRowBackground="#1A1A1D"
                          Foreground="#FAFAFA" GridLinesVisibility="None" HeadersVisibility="Column"
                          CanUserAddRows="False" Margin="0,8,0,0">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Sel" Binding="{Binding IsSelected}" Width="45" />
                        <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" IsReadOnly="True" />
                        <DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="180" IsReadOnly="True" />
                        <DataGridTextColumn Header="Duration" Binding="{Binding DurationFormatted}" Width="80" IsReadOnly="True" />
                        <DataGridTextColumn Header="Status" Binding="{Binding State}" Width="90" IsReadOnly="True" />
                        <DataGridTemplateColumn Header="Progress" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ProgressBar Value="{Binding Progress}" Maximum="100" Height="14" Background="#374151" Foreground="#3B82F6" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Speed" Binding="{Binding Speed}" Width="80" IsReadOnly="True" />
                        <DataGridTextColumn Header="ETA" Binding="{Binding Eta}" Width="60" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <!-- BOTTOM ACTION BAR -->
        <Border Grid.Row="4" Background="#202023" CornerRadius="8" Padding="12" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="#93C5FD" TextTrimming="CharacterEllipsis"/>
                    <ProgressBar Value="{Binding OverallProgress}" Maximum="100" Height="6" Margin="0,4,16,0" Background="#374151" Foreground="#10B981" />
                </StackPanel>

                <Button Grid.Column="1" Content="▶ Download Selected" Command="{Binding DownloadSelectedCommand}" 
                        Background="#10B981" Margin="0,0,8,0" Padding="16,8" />
                <Button Grid.Column="2" Content="⏹ Cancel" Command="{Binding CancelDownloadsCommand}" 
                        Background="#EF4444" Padding="14,8" />
            </Grid>
        </Border>
    </Grid>
</Window>
